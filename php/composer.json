{
    "name": "nicklambourne/slackblocks",
    "description": "Native, validated Slack Block Kit values for PHP",
    "type": "library",
    "license": "MIT",
    "homepage": "https://slackblocks.ndl.au",
    "support": {
        "issues": "https://github.com/nicklambourne/slackblocks/issues",
        "source": "https://github.com/nicklambourne/slackblocks/tree/master/php"
    },
    "keywords": [
        "slack",
        "block-kit",
        "messages"
    ],
    "require": {
        "php": ">=8.2",
        "php-64bit": ">=8.2",
        "ext-json": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.89"
    },
    "autoload": {
        "psr-4": {
            "Slackblocks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slackblocks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "archive": {
        "exclude": [
            "/bin",
            "/generator",
            "/tests",
            "/conformance",
            "/generated",
            "/typecheck",
            "/vendor",
            "/composer.lock",
            "/phpunit.xml",
            "/phpstan.neon",
            "/.php-cs-fixer.php",
            "/.gitignore",
            "/integrations",
            "/.php-cs-fixer.cache",
            "/.phpstan",
            "/.phpunit.cache",
            "/coverage"
        ]
    }
}
