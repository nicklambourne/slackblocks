#!/usr/bin/env bash
set -euo pipefail

if [[ -d /Volumes/Repos || -d /Volumes/Cache || -d /Volumes/Scratch ]]; then
  for mount in /Volumes/Repos /Volumes/Cache /Volumes/Scratch; do
    test -d "$mount" || { echo "Required mount unavailable: $mount" >&2; exit 1; }
  done
  scratch_root=/Volumes/Scratch
  export BUNDLE_PATH="${BUNDLE_PATH:-/Volumes/Cache/bundle/slackblocks-ruby34}"
  export BUNDLE_DISABLE_SHARED_GEMS=true
else
  scratch_root="${RUNNER_TEMP:?RUNNER_TEMP must be set outside mini}"
fi

ruby_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x /opt/homebrew/opt/ruby@3.4/bin/ruby ]]; then
  ruby_bin="${RUBY_BIN:-/opt/homebrew/opt/ruby@3.4/bin/ruby}"
else
  ruby_bin="${RUBY_BIN:-$(command -v ruby)}"
fi
gem_bin="$(dirname "$ruby_bin")/gem"
version="$("$ruby_bin" -I "$ruby_root/lib" -r slackblocks/version -e 'print Slackblocks::VERSION')"
scratch="$(mktemp -d "$scratch_root/slackblocks-ruby-smoke-XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
gem_file="$scratch/slackblocks-$version.gem"
install="$scratch/install"

(
  cd "$ruby_root"
  "$gem_bin" build slackblocks.gemspec --output "$gem_file"
)
"$gem_bin" install "$gem_file" --install-dir "$install" --no-document

"$ruby_bin" -r rubygems/package -e '
  spec = Gem::Package.new(ARGV.fetch(0)).spec
  abort "wrong gem name" unless spec.name == "slackblocks"
  abort "wrong gem version" unless spec.version.to_s == ARGV.fetch(1)
  abort "wrong Ruby floor" unless spec.required_ruby_version.satisfied_by?(Gem::Version.new("3.3.0"))
  abort "runtime dependencies present" unless spec.runtime_dependencies.empty?
  required = %w[lib/slackblocks.rb lib/slackblocks/components.rb sig/slackblocks.rbs sig/slackblocks/generated.rbs README.md CHANGELOG.md LICENSE]
  abort "missing package files" unless (required - spec.files).empty?
  abort "development inputs packaged" if spec.files.any? { |path| path.start_with?("generator/", "test/", "generated/") }
' "$gem_file" "$version"

(
  cd "$scratch"
  env -i PATH="$(dirname "$ruby_bin"):/usr/bin:/bin" GEM_HOME="$install" GEM_PATH="$install" \
    "$ruby_bin" - "$ruby_root" <<'RUBY'
require "json"
require "slackblocks"
root = ARGV.fetch(0)
section = Slackblocks::SectionBlock.new(text: "Installed gem")
message = Slackblocks::MessagePayload.new(channel: "C123", blocks: [section])
abort "bad installed output" unless JSON.parse(message.to_json).dig("blocks", 0, "text", "text") == "Installed gem"
abort "checkout runtime loaded" if $LOADED_FEATURES.any? { |path| path.start_with?(root) }
RUBY
  PATH="$(dirname "$ruby_bin"):$PATH" BUNDLE_GEMFILE="$ruby_root/Gemfile" bundle exec rbs -I "$install/gems/slackblocks-$version/sig" validate

  ln -s "$install/gems/slackblocks-$version/sig" sig
  cat > Steepfile <<RBS
target :installed do
  library "json"
  signature "sig"
  check "consumer.rb"
end
RBS
  cat > consumer.rb <<'RUBY'
require "slackblocks"
section = Slackblocks::SectionBlock.new(text: "Installed")
Slackblocks::MessagePayload.new(channel: "C123", blocks: [section]).to_json
RUBY
  PATH="$(dirname "$ruby_bin"):$PATH" BUNDLE_GEMFILE="$ruby_root/Gemfile" bundle exec steep check
)

echo "Built, inspected, installed, and type-checked slackblocks $version outside the checkout"
