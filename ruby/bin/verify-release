#!/usr/bin/env python3
"""Compatibility entry point for the shared seven-language release preflight."""

import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[2]
os.execv(
    sys.executable,
    [
        sys.executable,
        str(root / ".github/scripts/verify-release.py"),
        "publisher",
        "--language",
        "ruby",
    ],
)
