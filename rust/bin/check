#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
python3 rust/generator/generate.py --check
python3 -m unittest discover -s rust/generator -p 'test_*.py'
cargo +1.85.0 fmt --manifest-path rust/Cargo.toml --all -- --check
cargo +1.85.0 fmt --manifest-path rust/integrations/Cargo.toml --all -- --check
cargo +stable clippy --manifest-path rust/integrations/Cargo.toml --all-targets --locked -- -D warnings
cargo +stable clippy --manifest-path rust/Cargo.toml --workspace --all-targets --locked -- -D warnings
cargo +stable test --manifest-path rust/Cargo.toml --workspace --all-targets --locked
cargo +stable test --manifest-path rust/Cargo.toml --workspace --doc --locked
cargo +stable run --manifest-path rust/Cargo.toml --example api_checkpoint --locked
RUSTDOCFLAGS='-D warnings' cargo +stable doc --manifest-path rust/Cargo.toml --no-deps --locked
python3 rust/bin/check-ui.py --toolchain stable
python3 rust/bin/check-ui.py --toolchain 1.85.0
RUST_GUIDE_TOOLCHAIN=1.85.0 python3 docs/scripts/check_rust_guide_snippets.py
