{
  "name": "@nicklambourne/slackblocks",
  "version": "2.4.0",
  "description": "Typed Block Kit construction with eager, path-aware validation",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklambourne/slackblocks.git",
    "directory": "typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack --profile esm-only ."
  },
  "keywords": [
    "slack",
    "block-kit",
    "typescript",
    "validation"
  ],
  "slackblocksSpecVersion": "1.1.0",
  "dependencies": {
    "@slack/types": "^3.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
